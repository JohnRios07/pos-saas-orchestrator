+        stats.getPaymentMethodTotals().forEach(p -> {
+            if ("CASH".equals(p.getPaymentMethod())) {
+                assertThat(p.getTotal()).isEqualByComparingTo(new BigDecimal("100.00"));
+            } else if ("CARD".equals(p.getPaymentMethod())) {
+                assertThat(p.getTotal()).isEqualByComparingTo(new BigDecimal("200.00"));
+            }
