+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.*;
+
+@ExtendWith(MockitoExtension.class)
+public class CatalogServiceUnitTest {
+
+    @Mock
+    private CategoryRepository categoryRepository;
+    @Mock
+    private BrandRepository brandRepository;
+    @Mock
+    private ProductRepository productRepository;
+    @Mock
+    private ProductVariantRepository productVariantRepository;
+
+    @InjectMocks
+    private CatalogService catalogService;
+
+    private UUID tenantId = UUID.randomUUID();
+
+    @BeforeEach
+    void setUp() {
+        TenantContext.setTenantId(tenantId);
+    }
+
+    @Test
+    void createCategory() {
+        Category c = new Category();
+        when(categoryRepository.save(any())).thenReturn(c);
+        assertEquals(c, catalogService.createCategory(new Category()));
+    }
+
+    @Test
+    void getCategories() {
+        when(categoryRepository.findByTenantId(tenantId)).thenReturn(List.of(new Category()));
+        assertEquals(1, catalogService.getCategories().size());
+    }
+
+    @Test
+    void createBrand() {
+        Brand b = new Brand();
+        when(brandRepository.save(any())).thenReturn(b);
+        assertEquals(b, catalogService.createBrand(new Brand()));
+    }
+
+    @Test
+    void getBrands() {
+        when(brandRepository.findByTenantId(tenantId)).thenReturn(List.of(new Brand()));
+        assertEquals(1, catalogService.getBrands().size());
+    }
+
+    @Test
+    void createProduct() {
+        Product p = new Product();
+        ProductVariant pv = new ProductVariant();
+        p.setVariants(List.of(pv));
+        when(productRepository.save(any())).thenReturn(p);
+        assertEquals(p, catalogService.createProduct(p));
+    }
+
+    @Test
+    void getProducts() {
+        when(productRepository.findByTenantId(tenantId)).thenReturn(List.of(new Product()));
+        assertEquals(1, catalogService.getProducts().size());
+    }
+
+    @Test
+    void addVariantToProduct() {
+        Product p = new Product();
+        when(productRepository.findByIdAndTenantId(any(), any())).thenReturn(Optional.of(p));
+        ProductVariant pv = new ProductVariant();
+        when(productVariantRepository.save(any())).thenReturn(pv);
+        assertEquals(pv, catalogService.addVariantToProduct(UUID.randomUUID(), new ProductVariant()));
+    }
+
+    @Test
+    void addVariantToProduct_notFound() {
+        when(productRepository.findByIdAndTenantId(any(), any())).thenReturn(Optional.empty());
+        assertThrows(RuntimeException.class, () -> catalogService.addVariantToProduct(UUID.randomUUID(), new ProductVariant()));
+    }
+
+    @Test
+    void getVariantsByProduct() {
+        when(productVariantRepository.findByProductIdAndTenantId(any(), any())).thenReturn(List.of(new ProductVariant()));
+        assertEquals(1, catalogService.getVariantsByProduct(UUID.randomUUID()).size());
+    }
+
+    @Test
+    void updateVariantPrice() {
+        ProductVariant pv = new ProductVariant();
+        when(productVariantRepository.findByIdAndTenantId(any(), any())).thenReturn(Optional.of(pv));
+        when(productVariantRepository.save(any())).thenReturn(pv);
+        assertEquals(pv, catalogService.updateVariantPrice(UUID.randomUUID(), BigDecimal.TEN));
+    }
+
+    @Test
+    void updateVariantPrice_notFound() {
+        when(productVariantRepository.findByIdAndTenantId(any(), any())).thenReturn(Optional.empty());
+        assertThrows(RuntimeException.class, () -> catalogService.updateVariantPrice(UUID.randomUUID(), BigDecimal.TEN));
+    }
+}
