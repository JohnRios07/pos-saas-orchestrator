+package com.company.pos.billing.infrastructure.pdf;
+
+import com.company.pos.sales.domain.Sale;
+import com.company.pos.sales.domain.SaleItem;
+import com.company.pos.catalog.domain.ProductVariant;
+import com.company.pos.catalog.domain.Product;
+import org.junit.jupiter.api.Test;
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+import java.util.List;
+import java.util.UUID;
+import static org.junit.jupiter.api.Assertions.*;
+
+public class PdfReceiptGeneratorTest {
+    
+    @Test
+    void testGenerateReceipt() {
+        PdfReceiptGenerator gen = new PdfReceiptGenerator();
+        
+        Sale sale = new Sale();
+        sale.setId(UUID.randomUUID());
+        sale.setCompletedAt(LocalDateTime.now());
+        
+        SaleItem item = new SaleItem();
+        Product p = new Product();
+        p.setName("Product A");
+        ProductVariant pv = new ProductVariant();
+        pv.setProduct(p);
+        item.setVariant(pv);
+        item.setQuantity(new BigDecimal("2"));
+        item.setUnitPrice(new BigDecimal("10"));
+        item.setTotal(new BigDecimal("20"));
+        
+        sale.setItems(List.of(item));
+        sale.setSubtotal(new BigDecimal("20"));
+        sale.setDiscount(new BigDecimal("5"));
+        sale.setTotal(new BigDecimal("15"));
+        
+        byte[] pdf = gen.generateReceipt(sale);
+        assertNotNull(pdf);
+        assertTrue(pdf.length > 0);
+    }
