+    @Test
+    void createPurchase_completed_updatesInventory() {
+        Supplier s = new Supplier();
+        s.setName("Supplier A");
+        s.setDocumentNumber("DOC-123");
+        Supplier savedSupplier = purchasingService.createSupplier(s);
+
+        Purchase p = new Purchase();
+        p.setStoreId(store.getId());
+        p.setSupplierId(savedSupplier.getId());
+        p.setStatus("COMPLETED");
+        p.setTotalAmount(new BigDecimal("4000.00"));
+
+        PurchaseItem pi = new PurchaseItem();
+        pi.setVariantId(variant.getId());
+        pi.setQuantity(new BigDecimal("50"));
+        pi.setUnitCost(new BigDecimal("80.00"));
+        pi.setTotalCost(new BigDecimal("4000.00"));
+        p.setItems(List.of(pi));
+
+        Purchase savedPurchase = purchasingService.createPurchase(p);
+
+        assertThat(savedPurchase.getId()).isNotNull();
+
+        // Inventory should be 50
+        Inventory inv = inventoryRepository.findByTenantIdAndStoreIdAndVariantId(tenantId, store.getId(), variant.getId()).orElseThrow();
+        assertThat(inv.getQuantity()).isEqualByComparingTo(new BigDecimal("50"));
+        
+        List<Supplier> suppliers = purchasingService.listSuppliers();
+        assertThat(suppliers).hasSize(1);
+    }
+}
