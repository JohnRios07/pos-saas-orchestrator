+    @BeforeEach
+    void setUp() {
+        tenantId = UUID.randomUUID();
+        userId = UUID.randomUUID();
+        TenantContext.setTenantId(tenantId);
+        UserContext.setUserId(userId);
+
+        Tenant tenant = new Tenant();
+        tenant.setId(tenantId);
+        tenant.setName("Tenant Report");
+        tenant.setStatus("ACTIVE");
+        tenantRepository.save(tenant);
+
+        store = new Store();
+        store.setTenantId(tenantId);
+        store.setName("Main Store");
+        storeRepository.save(store);
+
+        register = new CashRegister();
+        register.setTenantId(tenantId);
+        register.setStoreId(store.getId());
+        register.setName("Main Register");
+        register.setActive(true);
+        cashRegisterRepository.save(register);
+
+        Product product = new Product();
+        product.setTenantId(tenantId);
+        product.setName("Product B");
+        productRepository.save(product);
+
+        variant = new ProductVariant();
+        variant.setTenantId(tenantId);
+        variant.setProduct(product);
+        variant.setSku("TEST-SKU");
+        variant.setPrice(new BigDecimal("100.00"));
+        variantRepository.save(variant);
+
+        cashService.openSession(store.getId(), register.getId(), new BigDecimal("100.00"), userId);
+    }
+
+    @Test
+    void getDashboardStats_calculatesSalesCorrectly() {
+        // Given some stock
+        MovementRequestDto mov = new MovementRequestDto();
+        mov.setStoreId(store.getId());
+        mov.setVariantId(variant.getId());
+        mov.setMovementType(MovementType.IN);
+        mov.setQuantity(new BigDecimal("10"));
+        mov.setCreatedBy(userId);
+        inventoryService.registerMovement(mov);
+
+        // Make sale 1: Total 100
+        Sale sale1 = new Sale();
+        sale1.setStoreId(store.getId());
+        sale1.setRegisterId(register.getId());
+        sale1.setCreatedBy(userId);
+        SaleItem item1 = new SaleItem();
+        item1.setVariant(variant);
+        item1.setQuantity(new BigDecimal("1"));
+        sale1.setItems(List.of(item1));
+        SalePayment pay1 = new SalePayment();
+        pay1.setPaymentMethod("CASH");
+        pay1.setAmount(new BigDecimal("100.00"));
+        sale1.setPayments(List.of(pay1));
+        saleService.createSale(sale1);
+
+        // Make sale 2: Total 200
+        Sale sale2 = new Sale();
+        sale2.setStoreId(store.getId());
+        sale2.setRegisterId(register.getId());
+        sale2.setCreatedBy(userId);
+        SaleItem item2 = new SaleItem();
+        item2.setVariant(variant);
+        item2.setQuantity(new BigDecimal("2"));
+        sale2.setItems(List.of(item2));
+        SalePayment pay2 = new SalePayment();
+        pay2.setPaymentMethod("CARD");
+        pay2.setAmount(new BigDecimal("200.00"));
+        sale2.setPayments(List.of(pay2));
+        saleService.createSale(sale2);
