+package com.company.pos.auth.application;
+
+import com.company.pos.auth.domain.User;
+import com.company.pos.auth.domain.UserRepository;
+import com.company.pos.tenant.domain.Tenant;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+import org.springframework.security.crypto.password.PasswordEncoder;
+
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@ExtendWith(MockitoExtension.class)
+public class AuthServiceUnitTest {
+
+    @Mock
+    private UserRepository userRepository;
+
+    @Mock
+    private PasswordEncoder passwordEncoder;
+
+    @Test
+    void testLogin_success() {
+        AuthService authService = new AuthService("my-super-secret-key-that-is-at-least-32-bytes-long", userRepository, passwordEncoder);
+        User u = new User();
+        u.setId(UUID.randomUUID());
+        u.setEmail("test@test.com");
+        u.setPasswordHash("hash");
+        u.setRole("ADMIN");
+        Tenant t = new Tenant();
+        t.setId(UUID.randomUUID());
+        u.setTenant(t);
+
+        when(userRepository.findByEmail("test@test.com")).thenReturn(List.of(u));
+        when(passwordEncoder.matches("pass", "hash")).thenReturn(true);
+
+        String token = authService.login("test@test.com", "pass");
+        assertNotNull(token);
+    }
+
+    @Test
+    void testLogin_invalidPass() {
+        AuthService authService = new AuthService("my-super-secret-key-that-is-at-least-32-bytes-long", userRepository, passwordEncoder);
+        User u = new User();
+        when(userRepository.findByEmail("test@test.com")).thenReturn(List.of(u));
+        when(passwordEncoder.matches("pass", u.getPasswordHash())).thenReturn(false);
+
+        assertThrows(RuntimeException.class, () -> authService.login("test@test.com", "pass"));
+    }
+
+    @Test
+    void testLogin_notFound() {
+        AuthService authService = new AuthService("my-super-secret-key-that-is-at-least-32-bytes-long", userRepository, passwordEncoder);
+        when(userRepository.findByEmail("test@test.com")).thenReturn(List.of());
+        assertThrows(RuntimeException.class, () -> authService.login("test@test.com", "pass"));
+    }
+}
