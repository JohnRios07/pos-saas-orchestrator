+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+@Transactional
+class SaleServiceIntegrationTest extends BaseIntegrationTest {
+
+    @Autowired private SaleService saleService;
+    @Autowired private SaleRepository saleRepository;
+    @Autowired private CashService cashService;
+    @Autowired private InventoryService inventoryService;
+    @Autowired private InventoryRepository inventoryRepository;
+    @Autowired private CashTransactionRepository cashTransactionRepository;
+
+    @Autowired private TenantRepository tenantRepository;
+    @Autowired private StoreRepository storeRepository;
+    @Autowired private CashRegisterRepository cashRegisterRepository;
+    @Autowired private ProductRepository productRepository;
+    @Autowired private ProductVariantRepository variantRepository;
+
+    private UUID tenantId;
+    private UUID userId;
+    private Store store;
+    private CashRegister register;
+    private ProductVariant variant;
+    private CashSession activeSession;
+
+    @BeforeEach
+    void setUp() {
+        tenantId = UUID.randomUUID();
+        userId = UUID.randomUUID();
+        TenantContext.setTenantId(tenantId);
+        UserContext.setUserId(userId);
+
+        Tenant tenant = new Tenant();
+        tenant.setId(tenantId);
+        tenant.setName("Tenant Test");
+        tenant.setStatus("ACTIVE");
+        tenantRepository.save(tenant);
+
+        store = new Store();
+        store.setTenantId(tenantId);
+        store.setName("Main Store");
+        storeRepository.save(store);
+
+        register = new CashRegister();
+        register.setTenantId(tenantId);
+        register.setStoreId(store.getId());
+        register.setName("Main Register");
+        register.setActive(true);
+        cashRegisterRepository.save(register);
+
+        Product product = new Product();
+        product.setTenantId(tenantId);
+        product.setName("Product A");
+        productRepository.save(product);
+
+        variant = new ProductVariant();
+        variant.setTenantId(tenantId);
+        variant.setProduct(product);
+        variant.setSku("TEST-SKU");
+        variant.setPrice(new BigDecimal("100.00"));
+        variantRepository.save(variant);
+
+        // Open cash session
+        activeSession = cashService.openSession(store.getId(), register.getId(), new BigDecimal("100.00"), userId);
+    }
+
+    @Test
+    void createSale_success_reducesInventory_and_addsCash() {
+        // Given inventory of 5
+        MovementRequestDto mov = new MovementRequestDto();
+        mov.setStoreId(store.getId());
+        mov.setVariantId(variant.getId());
+        mov.setMovementType(MovementType.IN);
+        mov.setQuantity(new BigDecimal("5.00"));
+        mov.setCreatedBy(userId);
+        inventoryService.registerMovement(mov);
+
+        // When creating a sale of 2 items
+        Sale sale = new Sale();
+        sale.setStoreId(store.getId());
+        sale.setRegisterId(register.getId());
+        sale.setCreatedBy(userId);
+        
+        SaleItem item = new SaleItem();
+        item.setVariant(variant);
+        item.setQuantity(new BigDecimal("2"));
+        // unit price will be set by service
+        sale.setItems(List.of(item));
+
+        SalePayment payment = new SalePayment();
+        payment.setPaymentMethod("CASH");
+        payment.setAmount(new BigDecimal("200.00"));
+        sale.setPayments(List.of(payment));
+
+        Sale savedSale = saleService.createSale(sale);
+
+        // Then sale is saved properly
+        assertThat(savedSale.getId()).isNotNull();
+        assertThat(savedSale.getTotal()).isEqualByComparingTo(new BigDecimal("200.00"));
+
+        // And inventory is reduced by 2
+        Inventory inv = inventoryRepository.findByTenantIdAndStoreIdAndVariantId(tenantId, store.getId(), variant.getId()).orElseThrow();
+        assertThat(inv.getQuantity()).isEqualByComparingTo(new BigDecimal("3.00"));
+
+        // And cash transaction is created
+        BigDecimal netTransactions = cashTransactionRepository.calculateNetTransactions(activeSession.getId(), tenantId);
+        assertThat(netTransactions).isEqualByComparingTo(new BigDecimal("200.00"));
+    }
+
+    @Test
+    void createSale_insufficientInventory_throwsException_and_rollsBack() {
+        // Given 0 inventory
+        Sale sale = new Sale();
+        sale.setStoreId(store.getId());
+        sale.setRegisterId(register.getId());
+        sale.setCreatedBy(userId);
+        
+        SaleItem item = new SaleItem();
+        item.setVariant(variant);
+        item.setQuantity(new BigDecimal("2"));
+        sale.setItems(List.of(item));
+
+        SalePayment payment = new SalePayment();
+        payment.setPaymentMethod("CASH");
+        payment.setAmount(new BigDecimal("200.00"));
+        sale.setPayments(List.of(payment));
+
+        // When
+        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () -> {
+            saleService.createSale(sale);
+        });
+
+        // Then
+        assertThat(ex.getMessage()).contains("Insufficient stock");
+    }
+    
+    @Test
+    void createSale_withoutOpenRegister_throwsException() {
+        cashService.closeSession(activeSession.getId(), new BigDecimal("100.00"), null);
+        
+        Sale sale = new Sale();
+        sale.setStoreId(store.getId());
+        sale.setRegisterId(register.getId());
+        sale.setCreatedBy(userId);
+        
+        RuntimeException ex = assertThrows(RuntimeException.class, () -> {
+            saleService.createSale(sale);
+        });
+        
+        assertThat(ex.getMessage()).contains("No active cash session found");
+    }
+
+    @Test
+    void refundSale_success_restoresInventory_and_removesCash() {
+        // Setup initial sale
+        MovementRequestDto mov = new MovementRequestDto();
+        mov.setStoreId(store.getId());
+        mov.setVariantId(variant.getId());
+        mov.setMovementType(MovementType.IN);
+        mov.setQuantity(new BigDecimal("5.00"));
+        mov.setCreatedBy(userId);
+        inventoryService.registerMovement(mov);
+
+        Sale sale = new Sale();
+        sale.setStoreId(store.getId());
+        sale.setRegisterId(register.getId());
+        sale.setCreatedBy(userId);
+        SaleItem item = new SaleItem();
+        item.setVariant(variant);
+        item.setQuantity(new BigDecimal("2"));
+        sale.setItems(List.of(item));
+        SalePayment payment = new SalePayment();
+        payment.setPaymentMethod("CASH");
+        payment.setAmount(new BigDecimal("200.00"));
+        sale.setPayments(List.of(payment));
+        Sale savedSale = saleService.createSale(sale);
+
+        // Refund
+        Sale refundedSale = saleService.refundSale(savedSale.getId(), register.getId());
+
+        // Then
+        assertThat(refundedSale.getStatus()).isEqualTo("REFUNDED");
+
+        // Inventory is back to 5
+        Inventory inv = inventoryRepository.findByTenantIdAndStoreIdAndVariantId(tenantId, store.getId(), variant.getId()).orElseThrow();
+        assertThat(inv.getQuantity()).isEqualByComparingTo(new BigDecimal("5.00"));
+
+        // Cash net transactions is 0
+        BigDecimal netTransactions = cashTransactionRepository.calculateNetTransactions(activeSession.getId(), tenantId);
+        assertThat(netTransactions).isEqualByComparingTo(BigDecimal.ZERO);
+    }
+}
