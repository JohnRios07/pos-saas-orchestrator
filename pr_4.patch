+package com.company.pos.reporting.application;
+
+import com.company.pos.tenant.application.TenantContext;
+import jakarta.persistence.EntityManager;
+import jakarta.persistence.Query;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.*;
+
+@ExtendWith(MockitoExtension.class)
+public class ReportingServiceUnitTest {
+
+    @Mock
+    private EntityManager entityManager;
+
+    @Mock
+    private Query query1;
+    
+    @Mock
+    private Query query2;
+    
+    @Mock
+    private Query query3;
+
+    @InjectMocks
+    private ReportingService reportingService;
+
+    @BeforeEach
+    void setUp() {
+        TenantContext.setTenantId(UUID.randomUUID());
+    }
+
+    @Test
+    void getDashboardStats_success() {
+        when(entityManager.createQuery(anyString()))
+            .thenReturn(query1)
+            .thenReturn(query2)
+            .thenReturn(query3);
+            
+        when(query1.setParameter(anyString(), any())).thenReturn(query1);
+        when(query1.getSingleResult()).thenReturn(new BigDecimal("100"));
+        
+        when(query2.setParameter(anyString(), any())).thenReturn(query2);
+        when(query2.getSingleResult()).thenReturn(2L);
+        
+        when(query3.setParameter(anyString(), any())).thenReturn(query3);
+        List<Object[]> rows = new ArrayList<>();
+        rows.add(new Object[]{"CASH", new BigDecimal("100")});
+        when(query3.getResultList()).thenReturn(rows);
+
+        var stats = reportingService.getDashboardStats(LocalDate.now(), LocalDate.now());
+        
+        assertEquals(new BigDecimal("100"), stats.getTotalSalesToday());
+        assertEquals(new BigDecimal("50.00"), stats.getAverageTicketToday());
+        assertEquals(1, stats.getPaymentMethodTotals().size());
+    }
+
+    @Test
+    void getDashboardStats_nullDates_nullResults() {
+        when(entityManager.createQuery(anyString()))
+            .thenReturn(query1)
+            .thenReturn(query2)
+            .thenReturn(query3);
+            
+        when(query1.setParameter(anyString(), any())).thenReturn(query1);
+        when(query1.getSingleResult()).thenReturn(null);
+        
+        when(query2.setParameter(anyString(), any())).thenReturn(query2);
+        when(query2.getSingleResult()).thenReturn(null);
+        
+        when(query3.setParameter(anyString(), any())).thenReturn(query3);
+        when(query3.getResultList()).thenReturn(new ArrayList<>());
+
+        var stats = reportingService.getDashboardStats(null, null);
+        
+        assertEquals(BigDecimal.ZERO, stats.getTotalSalesToday());
+        assertEquals(BigDecimal.ZERO, stats.getAverageTicketToday());
+    }
+
+    @Test
+    void getDashboardStats_noTenant() {
+        TenantContext.clear();
+        assertThrows(RuntimeException.class, () -> reportingService.getDashboardStats(null, null));
+    }
+}
