+package com.company.pos.cash.application;
+
+import com.company.pos.BaseIntegrationTest;
+import com.company.pos.auth.application.UserContext;
+import com.company.pos.cash.domain.*;
+import com.company.pos.tenant.application.TenantContext;
+import com.company.pos.tenant.domain.Store;
+import com.company.pos.tenant.domain.StoreRepository;
+import com.company.pos.tenant.domain.Tenant;
+import com.company.pos.tenant.domain.TenantRepository;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+@Transactional
+class CashServiceIntegrationTest extends BaseIntegrationTest {
+
+    @Autowired private CashService cashService;
+    @Autowired private CashSessionRepository cashSessionRepository;
+    @Autowired private CashRegisterRepository cashRegisterRepository;
+    @Autowired private CashTransactionRepository cashTransactionRepository;
+
+    @Autowired private TenantRepository tenantRepository;
+    @Autowired private StoreRepository storeRepository;
+
+    private UUID tenantId;
+    private UUID userId;
+    private Store store;
+    private CashRegister register;
+
+    @BeforeEach
+    void setUp() {
+        tenantId = UUID.randomUUID();
+        userId = UUID.randomUUID();
+        TenantContext.setTenantId(tenantId);
+        UserContext.setUserId(userId);
+
+        Tenant tenant = new Tenant();
+        tenant.setId(tenantId);
+        tenant.setName("Tenant Test");
+        tenant.setStatus("ACTIVE");
+        tenantRepository.save(tenant);
+
+        store = new Store();
+        store.setTenantId(tenantId);
+        store.setName("Main Store");
+        storeRepository.save(store);
+
+        register = new CashRegister();
+        register.setTenantId(tenantId);
+        register.setStoreId(store.getId());
+        register.setName("Main Register");
+        register.setActive(true);
+        cashRegisterRepository.save(register);
+    }
+
+    @Test
+    void openSession_success() {
+        CashSession session = cashService.openSession(store.getId(), register.getId(), new BigDecimal("150.00"), userId);
+
+        assertThat(session).isNotNull();
+        assertThat(session.getStatus()).isEqualTo("OPEN");
+        assertThat(session.getOpeningBalance()).isEqualByComparingTo(new BigDecimal("150.00"));
+    }
+
+    @Test
+    void openSession_alreadyOpen_throwsException() {
+        cashService.openSession(store.getId(), register.getId(), new BigDecimal("150.00"), userId);
+
+        RuntimeException ex = assertThrows(RuntimeException.class, () -> {
+            cashService.openSession(store.getId(), register.getId(), new BigDecimal("100.00"), userId);
+        });
+        assertThat(ex.getMessage()).contains("already open");
+    }
+
+    @Test
+    void closeSession_withExactBalance_success() {
+        CashSession session = cashService.openSession(store.getId(), register.getId(), new BigDecimal("100.00"), userId);
+        cashService.registerTransaction(session.getId(), "IN", new BigDecimal("50.00"), "Sale", "SALE", UUID.randomUUID(), userId);
+
+        CashSession closed = cashService.closeSession(session.getId(), new BigDecimal("150.00"), null);
+
+        assertThat(closed.getStatus()).isEqualTo("CLOSED");
+        assertThat(closed.getClosingBalanceActual()).isEqualByComparingTo(new BigDecimal("150.00"));
+        assertThat(closed.getClosingBalanceExpected()).isEqualByComparingTo(new BigDecimal("150.00"));
+    }
+
+    @Test
+    void closeSession_withDifferenceAndNoNotes_throwsException() {
+        CashSession session = cashService.openSession(store.getId(), register.getId(), new BigDecimal("100.00"), userId);
+        
+        IllegalArgumentException ex = assertThrows(IllegalArgumentException.class, () -> {
+            cashService.closeSession(session.getId(), new BigDecimal("90.00"), "");
+        });
+        
+        assertThat(ex.getMessage()).contains("Debe proveer una observación");
+    }
+
+    @Test
+    void closeSession_withDifferenceAndNotes_success() {
+        CashSession session = cashService.openSession(store.getId(), register.getId(), new BigDecimal("100.00"), userId);
+        
+        CashSession closed = cashService.closeSession(session.getId(), new BigDecimal("90.00"), "Faltan 10");
+        
+        assertThat(closed.getStatus()).isEqualTo("CLOSED");
+        assertThat(closed.getClosingBalanceExpected()).isEqualByComparingTo(new BigDecimal("100.00"));
+        assertThat(closed.getClosingBalanceActual()).isEqualByComparingTo(new BigDecimal("90.00"));
+        assertThat(closed.getClosingNotes()).isEqualTo("Faltan 10");
+    }
+}
