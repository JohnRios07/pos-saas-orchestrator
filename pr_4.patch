+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.UUID;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+@Transactional
+class CatalogServiceIntegrationTest extends BaseIntegrationTest {
+
+    @Autowired private CatalogService catalogService;
+    @Autowired private TenantRepository tenantRepository;
+    @Autowired private ProductRepository productRepository;
+    @Autowired private ProductVariantRepository variantRepository;
+
+    private UUID tenantId;
+
+    @BeforeEach
+    void setUp() {
+        tenantId = UUID.randomUUID();
+        TenantContext.setTenantId(tenantId);
+
+        Tenant tenant = new Tenant();
+        tenant.setId(tenantId);
+        tenant.setName("Tenant Catalog");
+        tenant.setStatus("ACTIVE");
+        tenantRepository.save(tenant);
+    }
+
+    @Test
+    void createAndGetProductsWithVariants() {
+        Product p = new Product();
+        p.setName("Test Product");
+        p.setDescription("Desc");
+        p.setActive(true);
+
+        ProductVariant v = new ProductVariant();
+        v.setSku("SKU123");
+        v.setPrice(new BigDecimal("150.00"));
+        p.setVariants(List.of(v));
+
+        Product saved = catalogService.createProduct(p);
+        assertThat(saved.getId()).isNotNull();
+        assertThat(saved.getVariants()).hasSize(1);
+        assertThat(saved.getVariants().get(0).getId()).isNotNull();
+
+        List<Product> products = catalogService.getProducts();
+        assertThat(products).hasSize(1);
+        assertThat(products.get(0).getName()).isEqualTo("Test Product");
+        assertThat(products.get(0).getDescription()).isEqualTo("Desc");
+
+        List<ProductVariant> variants = catalogService.getVariantsByProduct(saved.getId());
+        assertThat(variants).hasSize(1);
+        assertThat(variants.get(0).getSku()).isEqualTo("SKU123");
+        assertThat(variants.get(0).getPrice()).isEqualByComparingTo(new BigDecimal("150.00"));
+
+        ProductVariant updatedVariant = catalogService.updateVariantPrice(variants.get(0).getId(), new BigDecimal("200.00"));
+        assertThat(updatedVariant.getPrice()).isEqualByComparingTo(new BigDecimal("200.00"));
+    }
+    
+    @Test
+    void createAndGetCategoriesAndBrands() {
+        Category c = new Category();
+        c.setName("Electronics");
+        catalogService.createCategory(c);
+        
+        Brand b = new Brand();
+        b.setName("Samsung");
+        catalogService.createBrand(b);
+        
+        assertThat(catalogService.getCategories()).hasSize(1);
+        assertThat(catalogService.getBrands()).hasSize(1);
+    }
+}
